meas tran iavg AVG i(VDD_SRC) FROM=0n TO=10n
let pavg=abs(3.3*iavg)

echo 3 $&expected_step $&measured_step $&abs_error $&rel_error_percent $&vdiff_before $&vdiff_after $&vcp55 $&vcn55 $&vcp7 $&vcn7 $&cm7 $&voutp10 $&voutn10 $&outdiff10 $&pass_weight $&pass_comp $&iavg $&pavg >> cdac_bit_weight_sweep_results.txt


* ================================================================
* BIT 2
* ================================================================

alterparam BP3_FINAL=1.65
alterparam BN3_FINAL=1.65

alterparam BP2_FINAL=3.3
alterparam BN2_FINAL=0

reset
tran 1p 12n

meas tran vcp55 FIND v(vcp) AT=5.5n
meas tran vcn55 FIND v(vcn) AT=5.5n
let vdiff_before=vcp55-vcn55

meas tran vcp7 FIND v(vcp) AT=7n
meas tran vcn7 FIND v(vcn) AT=7n
let vdiff_after=vcp7-vcn7

let measured_step=vdiff_after-vdiff_before
let expected_step=0.012890625
let abs_error=abs(measured_step-expected_step)
let rel_error_percent=100*abs_error/expected_step
let cm7=0.5*(vcp7+vcn7)

meas tran voutp10 FIND v(Voutp) AT=10n
meas tran voutn10 FIND v(Voutn) AT=10n
let outdiff10=voutp10-voutn10

let pass_weight=0
if rel_error_percent < 10
    let pass_weight=1
end

let pass_comp=0
if outdiff10 > 2.5
    let pass_comp=1
end

meas tran iavg AVG i(VDD_SRC) FROM=0n TO=10n
let pavg=abs(3.3*iavg)

echo 2 $&expected_step $&measured_step $&abs_error $&rel_error_percent $&vdiff_before $&vdiff_after $&vcp55 $&vcn55 $&vcp7 $&vcn7 $&cm7 $&voutp10 $&voutn10 $&outdiff10 $&pass_weight $&pass_comp $&iavg $&pavg >> cdac_bit_weight_sweep_results.txt


* ================================================================
* BIT 1
* ================================================================

alterparam BP2_FINAL=1.65
alterparam BN2_FINAL=1.65

alterparam BP1_FINAL=3.3
alterparam BN1_FINAL=0

reset
tran 1p 12n

meas tran vcp55 FIND v(vcp) AT=5.5n
meas tran vcn55 FIND v(vcn) AT=5.5n
let vdiff_before=vcp55-vcn55

meas tran vcp7 FIND v(vcp) AT=7n
meas tran vcn7 FIND v(vcn) AT=7n
let vdiff_after=vcp7-vcn7

let measured_step=vdiff_after-vdiff_before
let expected_step=0.0064453125
let abs_error=abs(measured_step-expected_step)
let rel_error_percent=100*abs_error/expected_step
let cm7=0.5*(vcp7+vcn7)

meas tran voutp10 FIND v(Voutp) AT=10n
meas tran voutn10 FIND v(Voutn) AT=10n
let outdiff10=voutp10-voutn10

let pass_weight=0
if rel_error_percent < 10
    let pass_weight=1
end

let pass_comp=0
if outdiff10 > 2.5
    let pass_comp=1
end

meas tran iavg AVG i(VDD_SRC) FROM=0n TO=10n
let pavg=abs(3.3*iavg)

echo 1 $&expected_step $&measured_step $&abs_error $&rel_error_percent $&vdiff_before $&vdiff_after $&vcp55 $&vcn55 $&vcp7 $&vcn7 $&cm7 $&voutp10 $&voutn10 $&outdiff10 $&pass_weight $&pass_comp $&iavg $&pavg >> cdac_bit_weight_sweep_results.txt


* ================================================================
* BIT 0
* ================================================================

alterparam BP1_FINAL=1.65
alterparam BN1_FINAL=1.65

alterparam BP0_FINAL=3.3
alterparam BN0_FINAL=0

reset
tran 1p 12n

meas tran vcp55 FIND v(vcp) AT=5.5n
meas tran vcn55 FIND v(vcn) AT=5.5n
let vdiff_before=vcp55-vcn55

meas tran vcp7 FIND v(vcp) AT=7n
meas tran vcn7 FIND v(vcn) AT=7n
let vdiff_after=vcp7-vcn7

let measured_step=vdiff_after-vdiff_before
let expected_step=0.00322265625
let abs_error=abs(measured_step-expected_step)
let rel_error_percent=100*abs_error/expected_step
let cm7=0.5*(vcp7+vcn7)

meas tran voutp10 FIND v(Voutp) AT=10n
meas tran voutn10 FIND v(Voutn) AT=10n
let outdiff10=voutp10-voutn10

let pass_weight=0
if rel_error_percent < 10
