echo 0 $&expected_step $&measured_step $&abs_error $&rel_error_percent $&vdiff_before $&vdiff_after $&vcp55 $&vcn55 $&vcp7 $&vcn7 $&cm7 $&voutp10 $&voutn10 $&outdiff10 $&pass_weight $&pass_comp $&iavg $&pavg >> cdac_bit_weight_sweep_results.txt


* ================================================================
* BIT-SWEEP SUMMARY
* ================================================================

echo ================================================================ >> cdac_bit_weight_sweep_results.txt
echo END OF POST-LAYOUT BIT-WEIGHT SWEEP >> cdac_bit_weight_sweep_results.txt
