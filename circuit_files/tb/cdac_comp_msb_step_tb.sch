echo bit1 0.0064453125 >> cdac_bit_weight_sweep_results.txt
echo bit0 0.00322265625 >> cdac_bit_weight_sweep_results.txt
echo ================================================================ >> cdac_bit_weight_sweep_results.txt


* ================================================================
* RETURN ALL BOTTOM PLATES TO VCM
* ================================================================

alterparam BP0_FINAL=1.65
alterparam BN0_FINAL=1.65


* ================================================================
* SMALL-DIFFERENTIAL COMPARATOR TEST HEADER
* ================================================================

echo SMALL-DIFFERENTIAL SAMPLER AND COMPARATOR TEST >> cdac_bit_weight_sweep_results.txt
echo ================================================================ >> cdac_bit_weight_sweep_results.txt
echo Half-LSB differential = 3.3/2048 = 1.611328125 mV >> cdac_bit_weight_sweep_results.txt
echo All CDAC bottom plates remain at VCM >> cdac_bit_weight_sweep_results.txt
echo CASE VDIFF_SET expected_sign sample_4p5 sample_5p5 clk_7 clk_8p5 ainp_4p5 ainn_4p5 vcp_4p5 vcn_4p5 track_err_p track_err_n vcp_7 vcn_7 vdiff_hold cm_hold voutp_10 voutn_10 outdiff_10 pass_sign iavg pavg >> cdac_bit_weight_sweep_results.txt
echo ================================================================ >> cdac_bit_weight_sweep_results.txt


* ================================================================
* + HALF LSB
* ================================================================

alterparam VDIFF=0.001611328125

reset
tran 1p 12n

meas tran sample45 FIND v(sample) AT=4.5n
meas tran sample55 FIND v(sample) AT=5.5n

meas tran clk7 FIND v(CLK) AT=7n
meas tran clk85 FIND v(CLK) AT=8.5n

meas tran ainp45 FIND v(ainp) AT=4.5n
meas tran ainn45 FIND v(ainn) AT=4.5n

meas tran vcp45 FIND v(vcp) AT=4.5n
meas tran vcn45 FIND v(vcn) AT=4.5n

let track_err_p=vcp45-ainp45
let track_err_n=vcn45-ainn45

meas tran vcp7sd FIND v(vcp) AT=7n
meas tran vcn7sd FIND v(vcn) AT=7n

let vdiff_hold=vcp7sd-vcn7sd
let cm_hold=0.5*(vcp7sd+vcn7sd)

meas tran voutp10sd FIND v(Voutp) AT=10n
meas tran voutn10sd FIND v(Voutn) AT=10n

let outdiff10sd=voutp10sd-voutn10sd

let pass_sign=0
if outdiff10sd > 2.5
    let pass_sign=1
end

meas tran iavg_sd AVG i(VDD_SRC) FROM=0n TO=10n
let pavg_sd=abs(3.3*iavg_sd)

echo POS_HALF_LSB 0.001611328125 +1 $&sample45 $&sample55 $&clk7 $&clk85 $&ainp45 $&ainn45 $&vcp45 $&vcn45 $&track_err_p $&track_err_n $&vcp7sd $&vcn7sd $&vdiff_hold $&cm_hold $&voutp10sd $&voutn10sd $&outdiff10sd $&pass_sign $&iavg_sd $&pavg_sd >> cdac_bit_weight_sweep_results.txt


* ================================================================
* - HALF LSB
* ================================================================

alterparam VDIFF=-0.001611328125

reset
tran 1p 12n

meas tran sample45 FIND v(sample) AT=4.5n
meas tran sample55 FIND v(sample) AT=5.5n

meas tran clk7 FIND v(CLK) AT=7n
meas tran clk85 FIND v(CLK) AT=8.5n

meas tran ainp45 FIND v(ainp) AT=4.5n
meas tran ainn45 FIND v(ainn) AT=4.5n

meas tran vcp45 FIND v(vcp) AT=4.5n
meas tran vcn45 FIND v(vcn) AT=4.5n

let track_err_p=vcp45-ainp45
let track_err_n=vcn45-ainn45

meas tran vcp7sd FIND v(vcp) AT=7n
meas tran vcn7sd FIND v(vcn) AT=7n

let vdiff_hold=vcp7sd-vcn7sd
let cm_hold=0.5*(vcp7sd+vcn7sd)

meas tran voutp10sd FIND v(Voutp) AT=10n
meas tran voutn10sd FIND v(Voutn) AT=10n

let outdiff10sd=voutp10sd-voutn10sd

let pass_sign=0
if outdiff10sd < -2.5
    let pass_sign=1
end

meas tran iavg_sd AVG i(VDD_SRC) FROM=0n TO=10n
let pavg_sd=abs(3.3*iavg_sd)

echo NEG_HALF_LSB -0.001611328125 -1 $&sample45 $&sample55 $&clk7 $&clk85 $&ainp45 $&ainn45 $&vcp45 $&vcn45 $&track_err_p $&track_err_n $&vcp7sd $&vcn7sd $&vdiff_hold $&cm_hold $&voutp10sd $&voutn10sd $&outdiff10sd $&pass_sign $&iavg_sd $&pavg_sd >> cdac_bit_weight_sweep_results.txt


* ================================================================
* ZERO DIFFERENTIAL
* Observation only
* ================================================================

alterparam VDIFF=0

reset
tran 1p 12n

meas tran sample45 FIND v(sample) AT=4.5n
meas tran sample55 FIND v(sample) AT=5.5n

meas tran clk7 FIND v(CLK) AT=7n
meas tran clk85 FIND v(CLK) AT=8.5n

meas tran ainp45 FIND v(ainp) AT=4.5n
meas tran ainn45 FIND v(ainn) AT=4.5n

meas tran vcp45 FIND v(vcp) AT=4.5n
meas tran vcn45 FIND v(vcn) AT=4.5n

let track_err_p=vcp45-ainp45
let track_err_n=vcn45-ainn45

meas tran vcp7sd FIND v(vcp) AT=7n
meas tran vcn7sd FIND v(vcn) AT=7n

let vdiff_hold=vcp7sd-vcn7sd
let cm_hold=0.5*(vcp7sd+vcn7sd)

meas tran voutp10sd FIND v(Voutp) AT=10n
meas tran voutn10sd FIND v(Voutn) AT=10n

let outdiff10sd=voutp10sd-voutn10sd

let pass_sign=9

meas tran iavg_sd AVG i(VDD_SRC) FROM=0n TO=10n
let pavg_sd=abs(3.3*iavg_sd)

echo ZERO 0 0 $&sample45 $&sample55 $&clk7 $&clk85 $&ainp45 $&ainn45 $&vcp45 $&vcn45 $&track_err_p $&track_err_n $&vcp7sd $&vcn7sd $&vdiff_hold $&cm_hold $&voutp10sd $&voutn10sd $&outdiff10sd $&pass_sign $&iavg_sd $&pavg_sd >> cdac_bit_weight_sweep_results.txt


* ================================================================
* FINISH
* ================================================================

echo ================================================================ >> cdac_bit_weight_sweep_results.txt
echo END OF SMALL-DIFFERENTIAL TEST >> cdac_bit_weight_sweep_results.txt
echo PASS_SIGN: 1=correct 0=wrong 9=zero-diff-not-graded >> cdac_bit_weight_sweep_results.txt
echo ================================================================ >> cdac_bit_weight_sweep_results.txt

echo
echo CDAC post-layout sweep complete.
echo Open cdac_bit_weight_sweep_results.txt
echo

.endc


