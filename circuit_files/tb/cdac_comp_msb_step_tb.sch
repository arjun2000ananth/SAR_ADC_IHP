C {lab_pin.sym} -340 -350 3 0 {name=p29 sig_type=std_logic lab=CLK}
C {code.sym} 1090 -290 0 0 {name=s1
only_toplevel=true
value="
.param VDD=3.3
.param VCM=1.65
.param VDIFF=0
.param WCU=5u
.param LCU=5u
.param COUT_LOAD=20f

* Positive MSB test:
* bp9 goes high, bn9 goes low.
.param BP9_FINAL=\{VDD\}
.param BN9_FINAL=0

* All other bits stay at VCM.
.param BP8_FINAL=\{VCM\}
.param BP7_FINAL=\{VCM\}
.param BP6_FINAL=\{VCM\}
.param BP5_FINAL=\{VCM\}
.param BP4_FINAL=\{VCM\}
.param BP3_FINAL=\{VCM\}
.param BP2_FINAL=\{VCM\}
.param BP1_FINAL=\{VCM\}
.param BP0_FINAL=\{VCM\}

.param BN8_FINAL=\{VCM\}
.param BN7_FINAL=\{VCM\}
.param BN6_FINAL=\{VCM\}
.param BN5_FINAL=\{VCM\}
.param BN4_FINAL=\{VCM\}
.param BN3_FINAL=\{VCM\}
.param BN2_FINAL=\{VCM\}
.param BN1_FINAL=\{VCM\}
.param BN0_FINAL=\{VCM\}


* ================================================================
* SAVE SIGNALS
* ================================================================

.options savecurrents
.options reltol=1e-4 abstol=1e-12 vntol=1e-6 method=gear

.save v(sample)
.save v(sampleb)
.save v(CLK)

.save v(ainp)
.save v(ainn)

.save v(vcp)
.save v(vcn)

.save v(bp9) v(bp8) v(bp7) v(bp6) v(bp5)
.save v(bp4) v(bp3) v(bp2) v(bp1) v(bp0)

.save v(bn9) v(bn8) v(bn7) v(bn6) v(bn5)
.save v(bn4) v(bn3) v(bn2) v(bn1) v(bn0)

.save v(bpd)
.save v(bnd)

.save v(Voutp)
.save v(Voutn)

.save i(VDD_SRC)


* ================================================================
* CONTROL
* ================================================================

.control

set noaskquit
set numdgt=12

shell rm -f cdac_bit_weight_sweep_results.txt


* ================================================================
* RESULT FILE HEADER
* ================================================================

echo ================================================================ > cdac_bit_weight_sweep_results.txt
echo POST-LAYOUT CDAC BIT-WEIGHT SWEEP >> cdac_bit_weight_sweep_results.txt
echo ================================================================ >> cdac_bit_weight_sweep_results.txt
echo CDAC: extracted Magic PEX capacitance network >> cdac_bit_weight_sweep_results.txt
echo VDD = 3.3 V >> cdac_bit_weight_sweep_results.txt
echo VCM = 1.65 V >> cdac_bit_weight_sweep_results.txt
echo Nominal CMOM unit approximately 7.804 fF >> cdac_bit_weight_sweep_results.txt
echo Sample switch opens at 5 ns >> cdac_bit_weight_sweep_results.txt
echo CDAC bottom plates switch at 6 ns >> cdac_bit_weight_sweep_results.txt
echo CDAC result measured at 7 ns >> cdac_bit_weight_sweep_results.txt
echo Comparator CLK rises at 8 ns >> cdac_bit_weight_sweep_results.txt
echo Comparator output measured at 10 ns >> cdac_bit_weight_sweep_results.txt
echo Differential switching: BPk VCM-to-VDD and BNk VCM-to-0 >> cdac_bit_weight_sweep_results.txt
echo pass_weight = 1 when abs ideal-step error is below 10 percent >> cdac_bit_weight_sweep_results.txt
echo pass_comp = 1 when comparator produces positive output polarity >> cdac_bit_weight_sweep_results.txt
echo ================================================================ >> cdac_bit_weight_sweep_results.txt
echo BIT expected_step measured_step abs_error rel_error_percent vdiff_before vdiff_after vcp_5p5 vcn_5p5 vcp_7 vcn_7 cm_7 voutp_10 voutn_10 outdiff_10 pass_weight pass_comp iavg pavg >> cdac_bit_weight_sweep_results.txt
echo ================================================================ >> cdac_bit_weight_sweep_results.txt


* ================================================================
* INITIALISE ALL CDAC BOTTOM PLATES TO VCM
* ================================================================

alterparam VDIFF=0

alterparam BP9_FINAL=1.65
alterparam BP8_FINAL=1.65
alterparam BP7_FINAL=1.65
alterparam BP6_FINAL=1.65
alterparam BP5_FINAL=1.65
alterparam BP4_FINAL=1.65
alterparam BP3_FINAL=1.65
alterparam BP2_FINAL=1.65
alterparam BP1_FINAL=1.65
alterparam BP0_FINAL=1.65

alterparam BN9_FINAL=1.65
alterparam BN8_FINAL=1.65
alterparam BN7_FINAL=1.65
alterparam BN6_FINAL=1.65
alterparam BN5_FINAL=1.65
alterparam BN4_FINAL=1.65
alterparam BN3_FINAL=1.65
alterparam BN2_FINAL=1.65
alterparam BN1_FINAL=1.65
alterparam BN0_FINAL=1.65


* ================================================================
* BIT 9
* ================================================================

alterparam BP9_FINAL=3.3
alterparam BN9_FINAL=0

reset
tran 1p 12n

meas tran vcp55 FIND v(vcp) AT=5.5n
meas tran vcn55 FIND v(vcn) AT=5.5n
let vdiff_before = vcp55-vcn55

meas tran vcp7 FIND v(vcp) AT=7n
meas tran vcn7 FIND v(vcn) AT=7n
let vdiff_after = vcp7-vcn7

let measured_step = vdiff_after-vdiff_before
let expected_step = 1.650000000
let abs_error = abs(measured_step-expected_step)
let rel_error_percent = 100*abs_error/expected_step
let cm7 = 0.5*(vcp7+vcn7)

meas tran voutp10 FIND v(Voutp) AT=10n
meas tran voutn10 FIND v(Voutn) AT=10n
let outdiff10 = voutp10-voutn10

let pass_weight=0
if rel_error_percent < 10
    let pass_weight=1
end

let pass_comp=0
if outdiff10 > 2.5
    let pass_comp=1
end

meas tran iavg AVG i(VDD_SRC) FROM=0n TO=10n
let pavg=abs(3.3*iavg)

echo 9 $&expected_step $&measured_step $&abs_error $&rel_error_percent $&vdiff_before $&vdiff_after $&vcp55 $&vcn55 $&vcp7 $&vcn7 $&cm7 $&voutp10 $&voutn10 $&outdiff10 $&pass_weight $&pass_comp $&iavg $&pavg >> cdac_bit_weight_sweep_results.txt


* ================================================================
* BIT 8
* ================================================================

alterparam BP9_FINAL=1.65
alterparam BN9_FINAL=1.65

alterparam BP8_FINAL=3.3
alterparam BN8_FINAL=0

reset
tran 1p 12n

meas tran vcp55 FIND v(vcp) AT=5.5n
meas tran vcn55 FIND v(vcn) AT=5.5n
let vdiff_before=vcp55-vcn55

meas tran vcp7 FIND v(vcp) AT=7n
meas tran vcn7 FIND v(vcn) AT=7n
let vdiff_after=vcp7-vcn7

let measured_step=vdiff_after-vdiff_before
let expected_step=0.825000000
let abs_error=abs(measured_step-expected_step)
let rel_error_percent=100*abs_error/expected_step
let cm7=0.5*(vcp7+vcn7)

meas tran voutp10 FIND v(Voutp) AT=10n
meas tran voutn10 FIND v(Voutn) AT=10n
let outdiff10=voutp10-voutn10

let pass_weight=0
if rel_error_percent < 10
    let pass_weight=1
end

let pass_comp=0
if outdiff10 > 2.5
    let pass_comp=1
end

meas tran iavg AVG i(VDD_SRC) FROM=0n TO=10n
let pavg=abs(3.3*iavg)

echo 8 $&expected_step $&measured_step $&abs_error $&rel_error_percent $&vdiff_before $&vdiff_after $&vcp55 $&vcn55 $&vcp7 $&vcn7 $&cm7 $&voutp10 $&voutn10 $&outdiff10 $&pass_weight $&pass_comp $&iavg $&pavg >> cdac_bit_weight_sweep_results.txt


* ================================================================
